# =====================================================================
# ShopFlow 环境变量示例
#   用法：cp .env.example .env 后按需修改；.env 已被 .gitignore 忽略，不会提交。
#   生产环境请务必修改密码与 JWT 密钥。
# =====================================================================

# ---------- 对外端口（宿主机器端口，避免与本机已有服务冲突）----------
WEB_HOST_PORT=8080      # 前端入口，浏览器访问 http://localhost:8080
API_HOST_PORT=18080     # 后端直连端口（调试/接口文档用）
MYSQL_HOST_PORT=13306   # MySQL 映射端口（用客户端连库时使用）
REDIS_HOST_PORT=16379   # Redis 映射端口

# ---------- 数据库 ----------
MYSQL_DATABASE=shopflow
MYSQL_ROOT_PASSWORD=shopflow_root_pwd

# ---------- 安全 ----------
# 必须替换成自己的随机字符串，长度不少于 32 字节（HMAC-SHA256 要求）
SHOPFLOW_JWT_SECRET=shopflow-compose-secret-change-me-in-production-0123456789

# ---------- 跨域（生产由 Nginx 同源代理，通常无需额外放行）----------
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost